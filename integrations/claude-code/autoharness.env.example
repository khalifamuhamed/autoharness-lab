# Optional Autoharness knobs (documented in its README, "Configuration"). All have defaults; nothing is required.
# Put them in your shell, or in the "env" map of .claude/settings.json. NO secrets belong here.
# Project layer only (do not write skills into ~/.claude/skills):
AUTOHARNESS_DISABLE_GLOBAL=1
# Reflection cadence in TOOL CALLS (default 50). Lower = learns sooner, spawns more background sessions:
AUTOHARNESS_REFLECT_EVERY_N=50
# Lifecycle (defaults shown). The demo shrinks these to 5 / 2 so pruning is visible within a few sessions:
AUTOHARNESS_MATURITY_PROJECT=100
AUTOHARNESS_CAPACITY_PROJECT=50
# Merge pass cadence (default 250):
AUTOHARNESS_CONSOLIDATE_EVERY_N=250
# Desktop notification when a run lands skills (macOS osascript / Linux notify-send):
# AUTOHARNESS_NOTIFY=desktop
